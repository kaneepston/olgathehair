# Netlify headers configuration for long-term caching

# Images
/img/*
  Cache-Control: public, max-age=31536000, immutable

# CSS and JavaScript
/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

# Fonts (if any)
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.woff
  Cache-Control: public, max-age=31536000, immutable

# Videos
/video/*
  Cache-Control: public, max-age=31536000, immutable
